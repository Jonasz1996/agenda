# Kopieer naar .env (staat niet in git) en vul in.
POSTGRES_PASSWORD=verander-mij
# Wachtwoord voor de webinterface (of AGENDA_PASSWORD_HASH met een werkzeug-hash).
AGENDA_PASSWORD=verander-mij
# Optioneel: Bearer-token voor scripts die afspraken toevoegen of wissen.
AGENDA_API_TOKEN=
# Optioneel: ook lezen (en /ics) alleen met ?token=... Leeg = lezen open op het LAN (zoals nu, voor homepage).
AGENDA_READ_TOKEN=
# Via Authentik in NPM geen tweede login: de header die Authentik meestuurt en het IP van NPM.
AGENDA_PROXY_USER_HEADER=X-authentik-username
AGENDA_TRUSTED_PROXIES=
# Afvalkalender (recycleapp.be); kan ook in de webinterface.
RECYCLE_POSTCODE=
RECYCLE_STREET=
RECYCLE_NUMBER=
